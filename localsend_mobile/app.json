{
  "expo": {
    "name": "localsend_mobile",
    "slug": "localsend_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.localsendmobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "LocalSend necesita acceso a la red local para descubrir computadoras cercanas y enviarles archivos sin usar Internet.",
        "NSBonjourServices": ["_localsend._tcp", "_localsend._udp"],
        "NSPhotoLibraryUsageDescription": "LocalSend necesita acceso a tu galería para seleccionar fotos y videos.",
        "NSPhotoLibraryAddUsageDescription": "LocalSend puede guardar archivos recibidos en tu galería.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.localsendmobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-document-picker",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00C896",
          "sounds": []
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "31636b2c-a631-4c88-8498-f96a8fd9f0a5"
      }
    }
  }
}
